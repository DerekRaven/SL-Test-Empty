<Page x:Class="NeonCounterApp.Presentation.MainPage"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">
    <utu:SafeArea Insets="All">
        <Grid MaxWidth="480"
              Padding="{ThemeResource Space600Thickness}"
              RowDefinitions="Auto,*,Auto">

            <utu:AutoLayout Grid.Row="0"
                            Orientation="Horizontal"
                            Justify="SpaceBetween"
                            CounterAxisAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource LabelLarge}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           CharacterSpacing="400"
                           VerticalAlignment="Center" />
                <Border Background="{ThemeResource PrimaryContainerBrush}"
                        CornerRadius="{ThemeResource RadiusFullCornerRadius}"
                        Padding="14,6">
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource OnPrimaryContainerBrush}"
                               CharacterSpacing="150" />
                </Border>
            </utu:AutoLayout>

            <StackPanel Grid.Row="1"
                        Spacing="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding CountText}"
                           Style="{StaticResource DisplayLarge}"
                           FontSize="136"
                           FontWeight="Light"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           HorizontalAlignment="Center"
                           AutomationProperties.Name="Current count" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center">
                    <TextBlock Text="PEAK"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               CharacterSpacing="300"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PeakText}"
                               Style="{StaticResource TitleMedium}"
                               Foreground="{ThemeResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Spacing="12">
                <Button Content="&#x2B;"
                        Style="{StaticResource FilledButtonStyle}"
                        FontSize="32"
                        Height="72"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Click="Increment_Click"
                        AutomationProperties.Name="Increment" />
                <utu:AutoLayout Orientation="Horizontal"
                                Spacing="12">
                    <Button Content="&#x2212;"
                            Style="{StaticResource FilledTonalButtonStyle}"
                            FontSize="22"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            utu:AutoLayout.PrimaryAlignment="Stretch"
                            Click="Decrement_Click"
                            AutomationProperties.Name="Decrement" />
                    <Button Content="{Binding StepText}"
                            Style="{StaticResource FilledTonalButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            utu:AutoLayout.PrimaryAlignment="Stretch"
                            Click="Step_Click"
                            AutomationProperties.Name="Change step size" />
                    <Button Content="RESET"
                            Style="{StaticResource TextButtonStyle}"
                            Height="52"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            utu:AutoLayout.PrimaryAlignment="Stretch"
                            Click="Reset_Click"
                            AutomationProperties.Name="Reset counter" />
                </utu:AutoLayout>
            </StackPanel>
        </Grid>
    </utu:SafeArea>
</Page>
